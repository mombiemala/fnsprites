<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Preferred: reference CUE4Parse as a git submodule (see README).
      This is how most dataminer tooling pins it, because the library moves fast
      and there is no reliably-maintained official NuGet package.

        git submodule add https://github.com/FabianFG/CUE4Parse ../CUE4Parse
    -->
    <ProjectReference Include="../CUE4Parse/CUE4Parse/CUE4Parse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
